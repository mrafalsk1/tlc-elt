# Copie para .env e ajuste se quiser.
POSTGRES_USER=dw
POSTGRES_PASSWORD=dw
POSTGRES_DB=airflow

# Conexão usada dentro do Docker (host = nome do serviço)
WAREHOUSE_HOST=postgres
WAREHOUSE_PORT=5432
WAREHOUSE_DB=warehouse

# Conexão usada da sua máquina (porta publicada no compose)
WAREHOUSE_HOST_LOCAL=localhost
WAREHOUSE_PORT_LOCAL=5433
